<UserControl x:Class="Imview.Core.Views.ResultDynamicViewerView"
             x:Name="ResultViewerControl"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Imview.Core.ViewModels"
             xmlns:views="clr-namespace:Imview.Core.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450">
  
  <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="0" Margin="0">
      <TreeView ItemsSource="{Binding ViewModel.PropertyNodes, ElementName=ResultViewerControl}" Padding="0" Margin="0">
        <TreeView.Styles>
          <Style Selector="TreeViewItem">
            <Setter Property="Padding" Value="0,1"/>
            <Setter Property="Margin" Value="0"/>
          </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
          <TreeDataTemplate ItemsSource="{Binding Children}" DataType="vm:PropertyNode">
            <StackPanel Orientation="Horizontal">
              <!-- Colored status indicator for ResTeleport results -->
              <Border Width="8" Height="8" CornerRadius="2" Margin="0,0,2,0" VerticalAlignment="Center"
                      IsVisible="{Binding TeleportStatus, Converter={x:Static vm:TeleportDataStatusToBoolConverter.Instance}}">
                <Border.Background>
                  <MultiBinding Converter="{x:Static vm:TeleportDataStatusToColorConverter.Instance}">
                    <Binding Path="TeleportStatus"/>
                  </MultiBinding>
                </Border.Background>
              </Border>
              
              <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="8" Margin="0,0,2,0"/>
              <TextBlock Text=":" FontSize="8" Margin="0,0,2,0"/>
              <TextBlock Text="{Binding Value}" FontSize="8" Margin="0,0,4,0"/>
              <TextBlock Text="{Binding TypeName}" FontStyle="Italic" FontSize="7" Opacity="0.6"/>
              
              <!-- Edit button for database-loaded ResTeleport -->
              <Button Content="✏️" Width="16" Height="16" FontSize="8" Margin="2,0,0,0" Padding="1"
                      Click="EditButton_Click"
                      Tag="{Binding}"
                      ToolTip.Tip="Edit teleport data in database"
                      IsVisible="{Binding CanEdit}"/>
              
              <!-- Status text for debugging (optional) -->
              <TextBlock Text="{Binding TeleportStatus}" FontSize="6" Opacity="0.5" Margin="2,0,0,0"
                         IsVisible="{Binding TeleportStatus, Converter={x:Static vm:TeleportDataStatusToBoolConverter.Instance}}"/>
            </StackPanel>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
    </ScrollViewer>
  </Grid>

</UserControl>
