<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Imview.Core.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
        x:Class="Imview.Core.Views.DatabaseConfigWindow"
        x:DataType="vm:DatabaseConfigViewModel"
        Title="Database Configuration - Imview"
        Width="600" Height="500"
        WindowStartupLocation="CenterScreen"
        CanResize="false">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="10">
            <TextBlock Text="Database Configuration" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Configure your RavenDB connection for storing quest data." 
                      TextWrapping="Wrap" Foreground="Gray"/>
            <Separator Margin="0,10"/>
        </StackPanel>
        
        <!-- Configuration Options -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="15">
                
                <!-- Remote Database Configuration -->
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="15">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Remote Database Settings" FontWeight="Bold"/>
                        <TextBlock Text="Connect to a remote RavenDB server for storing quest data." 
                                 FontSize="12" Foreground="Gray"/>
                        
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" 
                              HorizontalAlignment="Stretch">
                            <Grid.Styles>
                                <Style Selector="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                </Style>
                                <Style Selector="TextBox">
                                    <Setter Property="Margin" Value="0,5"/>
                                </Style>
                            </Grid.Styles>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Server URL:"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DatabaseUrl}"
                                   Watermark="https://your-server.com:8080"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Database Name:"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DatabaseName}"/>
                            
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Certificate Path:"/>
                            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding CertificatePath}"
                                       Watermark="Path to .pfx certificate file (optional)"/>
                                <Button Grid.Column="1" Content="Browse..." Margin="5,0,0,0"
                                      Command="{Binding BrowseCertificateCommand}"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Test Connection Button -->
                <Button Content="{Binding TestButtonText}" 
                       Command="{Binding TestConnectionCommand}"
                       IsEnabled="{Binding !IsTestingConnection}"
                       HorizontalAlignment="Center"/>
                
                <!-- Connection Status -->
                <TextBlock Text="{Binding ConnectionStatus}" 
                         Foreground="{Binding ConnectionStatusColor}"
                         HorizontalAlignment="Center"
                         FontWeight="Bold"/>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Bottom Buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,20,0,0">
            <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" 
                   Margin="0,0,10,0"/>
            <Button Grid.Column="2" Content="Save &amp; Continue" Command="{Binding SaveCommand}"
                   IsEnabled="{Binding CanSave}" Classes="accent"/>
        </Grid>
    </Grid>
</Window>