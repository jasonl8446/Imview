<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Imview.Core.Views.DeleteConfirmationDialog"
        Title="Confirm Delete"
        Width="400"
        Height="180"
        MinWidth="400"
        MinHeight="180"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Icon and Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="15" Margin="0,0,0,20">
            <TextBlock Text="🗑️" FontSize="24" VerticalAlignment="Center"/>
            <TextBlock Text="Delete Quest" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
        
        <!-- Message -->
        <TextBlock Grid.Row="1" 
                   x:Name="MessageText"
                   TextWrapping="Wrap"
                   Margin="0,0,0,20"
                   VerticalAlignment="Center"/>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Name="DeleteButton" Content="Delete" 
                   MinWidth="80" Padding="10,5"
                   Background="DarkRed"
                   Foreground="White"
                   Click="DeleteButton_Click"/>
            <Button Name="CancelButton" Content="Cancel" 
                   MinWidth="80" Padding="10,5"
                   Classes="accent"
                   Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>