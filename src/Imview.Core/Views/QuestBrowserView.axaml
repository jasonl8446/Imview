<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Imview.Core.ViewModels"
             xmlns:views="using:Imview.Core.Views"
             xmlns:templates="using:Imview.Core.Controls.Templates"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Imview.Core.Views.QuestBrowserView"
             x:DataType="vm:QuestBrowserViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveQuestCommand}"/>
    </UserControl.KeyBindings>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header and Controls -->
        <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" 
                Padding="15">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto">
                <!-- Search Box -->
                <TextBox Grid.Column="0" 
                        Text="{Binding SearchText}" 
                        Watermark="Search quests..."
                        Width="300" HorizontalAlignment="Left"/>
                
                <!-- Refresh Button -->
                <Button Grid.Column="1" Content="Refresh"
                       Command="{Binding RefreshCommand}"
                       Margin="10,0,0,0"/>

                <!-- Import Packet Capture Button -->
                <Button Grid.Column="2" Content="Import Packet Capture"
                       Command="{Binding ImportPacketCaptureCommand}"
                       Margin="10,0,0,0"/>

                <!-- New Quest Button -->
                <Button Grid.Column="3" Content="New Quest"
                       Command="{Binding NewQuestCommand}"
                       Margin="10,0,0,0" Classes="accent"/>

                <!-- Load Local Quest Button -->
                <Button Grid.Column="4" Content="Load Local Quest"
                       Command="{Binding LoadLocalQuestCommand}"
                       Margin="10,0,0,0"/>

                <!-- Delete Selected Button -->
                <Button Grid.Column="5" Content="Delete Selected"
                       Command="{Binding DeleteSelectedCommand}"
                       IsEnabled="{Binding HasSelectedQuest}"
                       Margin="10,0,0,0"/>
            </Grid>
        </Border>
        
        <!-- Quest List -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Quest List Panel -->
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- List Header -->
                    <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" 
                            Padding="10,5">
                        <TextBlock Text="{Binding QuestCountText}" FontWeight="Bold"/>
                    </Border>
                    
                    <!-- Quest List -->
                    <ListBox Grid.Row="1" 
                            ItemsSource="{Binding FilteredQuests}"
                            SelectedItem="{Binding SelectedQuest}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="5" Margin="10">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Description}" 
                                             TextWrapping="Wrap" 
                                             Foreground="Gray"
                                             FontSize="12"
                                             MaxHeight="40"/>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='Created: {0:MM/dd/yyyy}'}" 
                                                 FontSize="10" Foreground="Gray"/>
                                        <TextBlock Text="{Binding ModifiedBy, StringFormat='by {0}'}" 
                                                 FontSize="10" Foreground="Gray"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <!-- Loading/Status -->
                    <TextBlock Grid.Row="2" 
                              Text="{Binding StatusText}" 
                              Padding="10"
                              HorizontalAlignment="Center"
                              Foreground="Gray"/>
                </Grid>
            </Border>
            
            <!-- Splitter -->
            <GridSplitter Grid.Column="1" 
                         Background="Gray" 
                         HorizontalAlignment="Stretch"/>
            
            <!-- Quest Editor Panel -->
            <Border Grid.Column="2" Padding="0">
                <Grid>
                    <!-- Quest Editor Content -->
                    <ScrollViewer IsVisible="{Binding HasSelectedQuest}">
                        <StackPanel Spacing="10" Margin="15">
                            <!-- Quest Header Info -->
                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="15">
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" 
                                              Text="Quest Name:" 
                                              FontWeight="Bold" 
                                              Margin="0,0,10,0" 
                                              VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" 
                                            Text="{Binding SelectedQuest.Name}" 
                                            Margin="0,0,10,0"/>
                                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="10">
                                        <Button Command="{Binding SaveQuestCommand}"
                                               IsEnabled="{Binding HasSelectedQuest}"
                                               Classes="accent">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock Text="●" 
                                                          IsVisible="{Binding HasUnsavedChanges}"
                                                          Foreground="Orange"
                                                          VerticalAlignment="Center"/>
                                                <TextBlock Text="Save" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Content="Export" 
                                               Command="{Binding ExportCommand}"
                                               IsEnabled="{Binding HasSelectedQuest}"/>
                                    </StackPanel>
                                    
                                    <TextBlock Grid.Row="1" Grid.Column="0" 
                                              Text="Description:" 
                                              FontWeight="Bold" 
                                              Margin="0,10,10,0" 
                                              VerticalAlignment="Top"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                            Text="{Binding SelectedQuest.Description}" 
                                            AcceptsReturn="True" 
                                            TextWrapping="Wrap" 
                                            Height="60"
                                            Margin="0,10,0,0"/>
                                </Grid>
                            </Border>
                            
                            <!-- Embedded Quest Editor -->
                            <ContentControl Content="{Binding QuestEditorViewModel}"
                                          IsVisible="{Binding HasSelectedQuest}">
                                <ContentControl.DataTemplates>
                                    <DataTemplate DataType="{x:Type vm:QuestTemplateEditorViewModel}">
                                        <views:QuestTemplateEditorView/>
                                    </DataTemplate>
                                </ContentControl.DataTemplates>
                            </ContentControl>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- Empty Selection Message -->
                    <StackPanel IsVisible="{Binding !HasSelectedQuest}" 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Center"
                               Spacing="10">
                        <TextBlock Text="No quest selected" 
                                  FontSize="18" 
                                  Foreground="Gray" 
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="Create a new quest, load from file, or select one from the database" 
                                  Foreground="Gray" 
                                  HorizontalAlignment="Center"
                                  TextWrapping="Wrap"
                                  TextAlignment="Center"
                                  MaxWidth="300"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>