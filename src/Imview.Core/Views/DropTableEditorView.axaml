<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Imview.Core.ViewModels"
             xmlns:models="clr-namespace:Imview.Core.Database.Models"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="Imview.Core.Views.DropTableEditorView"
             x:DataType="vm:DropTableEditorViewModel">

    <Grid Background="#1E1E1E" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="20" Margin="0,0,0,20">
            <TextBlock Text="Drop Table Editor"
                      FontSize="24"
                      FontWeight="Bold"
                      Foreground="White"
                      VerticalAlignment="Center"/>
            
            <Button Content="Create New Table"
                    Command="{Binding CreateTableCommand}"
                    Classes="accent"
                    Padding="15,8"
                    VerticalAlignment="Center"/>
            
            <Button Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    Padding="10,8"
                    VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Table List -->
            <Border Grid.Column="0" 
                    Background="#333333"
                    CornerRadius="6"
                    Padding="15"
                    BorderBrush="#888888"
                    BorderThickness="1"
                    Margin="0,0,10,0">
                <StackPanel Spacing="15">
                    <TextBlock Text="Drop Tables"
                              FontSize="18"
                              FontWeight="Bold"
                              Foreground="White"/>

                    <!-- Search -->
                    <TextBox Text="{Binding SearchText}"
                            Watermark="Search tables..."
                            Background="#444444"
                            Foreground="White"/>

                    <!-- Table List -->
                    <ListBox ItemsSource="{Binding DropTables}"
                            SelectedItem="{Binding SelectedDropTable}"
                            Background="Transparent"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#444444"
                                       CornerRadius="4"
                                       Padding="10"
                                       Margin="0,2">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{Binding Name}"
                                                  FontWeight="Medium"
                                                  Foreground="White"/>
                                        <TextBlock Text="{Binding Description}"
                                                  FontSize="11"
                                                  Foreground="#AAAAAA"
                                                  TextWrapping="Wrap"
                                                  MaxHeight="30"
                                                  IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Text="{Binding Items.Count, StringFormat=\{0\} items}"
                                                  FontSize="12"
                                                  Foreground="#CCCCCC"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Status -->
                    <TextBlock Text="{Binding StatusMessage}"
                              Foreground="#CCCCCC"
                              FontSize="12"
                              TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Right Panel - Editor -->
            <Border Grid.Column="1" 
                    Background="#333333"
                    CornerRadius="6"
                    Padding="20"
                    BorderBrush="#888888"
                    BorderThickness="1"
                    IsVisible="{Binding SelectedDropTable, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ScrollViewer>
                    <StackPanel Spacing="20">
                        <!-- Table Info -->
                        <StackPanel Spacing="15">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding SelectedDropTable.Name, StringFormat='Editing: {0}'}"
                                          FontSize="20"
                                          FontWeight="Bold"
                                          Foreground="White"/>
                                <TextBlock Text="{Binding SelectedDropTable.Description}"
                                          FontSize="14"
                                          Foreground="#CCCCCC"
                                          TextWrapping="Wrap"
                                          IsVisible="{Binding SelectedDropTable.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>

                            <!-- Table Properties -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="5" Margin="0,0,10,0">
                                    <TextBlock Text="Roll Chance (0-1):" 
                                              Foreground="White"
                                              ToolTip.Tip="Controls whether this drop table is even considered when a drop occurs. 1.0 = always considered, 0.5 = 50% chance to be considered."/>
                                    <NumericUpDown Value="{Binding RollChance}"
                                                  Minimum="0"
                                                  Maximum="1"
                                                  Increment="0.01"
                                                  FormatString="F2"
                                                  Background="#444444"
                                                  Foreground="White"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="5" Margin="10,0,0,0">
                                    <TextBlock Text="Weight:" 
                                              Foreground="White"
                                              ToolTip.Tip="When multiple drop tables compete (e.g., monster table + zone table), this determines relative priority. Higher weight = more likely to be chosen over other tables."/>
                                    <NumericUpDown Value="{Binding Weight}"
                                                  Minimum="0"
                                                  Maximum="1000"
                                                  Background="#444444"
                                                  Foreground="White"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="5" Margin="0,10,10,0">
                                    <TextBlock Text="None Chance (0-1):" 
                                              Foreground="White"
                                              ToolTip.Tip="Even if this table is selected, this is the chance that no item drops at all. 0.1 = 10% chance of getting nothing from this table."/>
                                    <NumericUpDown Value="{Binding NoneChance}"
                                                  Minimum="0"
                                                  Maximum="1"
                                                  Increment="0.01"
                                                  FormatString="F2"
                                                  Background="#444444"
                                                  Foreground="White"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5" Margin="10,10,0,0">
                                    <TextBlock Text="Pity Counter:" 
                                              Foreground="White"
                                              ToolTip.Tip="Each time a player gets nothing from this table, increase their drop chance by this amount. Helps prevent extremely unlucky streaks."/>
                                    <NumericUpDown Value="{Binding PityCounter}"
                                                  Minimum="0"
                                                  Increment="0.01"
                                                  FormatString="F2"
                                                  Background="#444444"
                                                  Foreground="White"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="5" Margin="0,10,10,0">
                                    <TextBlock Text="Min Gold (Range):"
                                              Foreground="White"
                                              ToolTip.Tip="Minimum gold for random range. For fixed gold, set Min = Max."/>
                                    <NumericUpDown Value="{Binding MinGold}"
                                                  Minimum="0"
                                                  Maximum="999999999"
                                                  FormatString="N0"
                                                  Background="#444444"
                                                  Foreground="White"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="5" Margin="10,10,0,0">
                                    <TextBlock Text="Max Gold (Range):"
                                              Foreground="White"
                                              ToolTip.Tip="Maximum gold for random range. For fixed gold, set Min = Max."/>
                                    <NumericUpDown Value="{Binding MaxGold}"
                                                  Minimum="0"
                                                  Maximum="999999999"
                                                  FormatString="N0"
                                                  Background="#444444"
                                                  Foreground="White"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="0" Spacing="5" Margin="0,10,10,0">
                                    <TextBlock Text="Experience Amount:" 
                                              Foreground="White"
                                              ToolTip.Tip="Fixed amount of experience points awarded from this drop table."/>
                                    <NumericUpDown Value="{Binding ExperienceAmount}"
                                                  Minimum="0"
                                                  Maximum="999999999"
                                                  FormatString="N0"
                                                  Background="#444444"
                                                  Foreground="White"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="1" Spacing="5" Margin="10,10,0,0">
                                    <TextBlock Text="Training Points:"
                                              Foreground="White"
                                              ToolTip.Tip="Fixed number of training points awarded from this drop table."/>
                                    <NumericUpDown Value="{Binding TrainingPoints}"
                                                  Minimum="0"
                                                  Maximum="999"
                                                  FormatString="N0"
                                                  Background="#444444"
                                                  Foreground="White"/>
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Spacing="5" Margin="0,10,0,0">
                                    <CheckBox IsChecked="{Binding GrantsPotionSlot}"
                                             Foreground="White"
                                             Content="Grants Additional Potion Slot"
                                             ToolTip.Tip="If checked, grants the player one additional potion slot when this drop table is rolled."/>
                                </StackPanel>
                            </Grid>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                                <Button Content="Save Table"
                                       Command="{Binding SaveTableCommand}"
                                       Classes="accent"
                                       Padding="15,8"/>
                                <Button Content="Delete Table"
                                       Command="{Binding DeleteTableCommand}"
                                       Background="#CC4444"
                                       Padding="15,8"/>
                                <Button Content="Add Item"
                                       Command="{Binding AddItemCommand}"
                                       Padding="15,8"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Reward Summary -->
                        <Border Background="#2A2A2A" CornerRadius="4" Padding="15" Margin="0,10,0,0"
                               IsVisible="{Binding RewardSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Rewards Summary:" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding RewardSummary}" Foreground="#CCCCCC" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Items Table -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="Drop Items (Optional)"
                                      FontSize="16"
                                      FontWeight="Bold"
                                      Foreground="White"/>

                            <!-- Header -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Item ID (Optional)" FontWeight="Bold" Foreground="White" Padding="5"/>
                                <TextBlock Grid.Column="1" Text="Item Name (Optional)" FontWeight="Bold" Foreground="White" Padding="5"/>
                                <TextBlock Grid.Column="2" Text="Notes" FontWeight="Bold" Foreground="White" Padding="5"/>
                                <TextBlock Grid.Column="3" Text="Requirements" FontWeight="Bold" Foreground="White" Padding="5"/>
                                <TextBlock Grid.Column="4" Text="Actions" FontWeight="Bold" Foreground="White" Padding="5"/>
                            </Grid>

                            <!-- Items List -->
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DropItemViewModel">
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0" 
                                                    Text="{Binding ItemId}"
                                                    Background="#444444"
                                                    Foreground="White"
                                                    Margin="2"
                                                    Watermark="Item ID"/>

                                            <TextBox Grid.Column="1" 
                                                    Text="{Binding ItemName}"
                                                    Background="#444444"
                                                    Foreground="White"
                                                    Margin="2"
                                                    Watermark="Item Name"/>

                                            <TextBox Grid.Column="2" 
                                                    Text="{Binding Notes}"
                                                    Background="#444444"
                                                    Foreground="White"
                                                    Margin="2"
                                                    Watermark="Notes"/>

                                            <Button Grid.Column="3" 
                                                   Content="{Binding RequirementsText}"
                                                   Command="{Binding $parent[UserControl].((vm:DropTableEditorViewModel)DataContext).EditItemRequirementsCommand}"
                                                   CommandParameter="{Binding}"
                                                   Background="#555555"
                                                   Foreground="White"
                                                   Padding="8,4"
                                                   Margin="2"
                                                   FontSize="11"
                                                   ToolTip.Tip="Click to edit item requirements"/>

                                            <Button Grid.Column="4" 
                                                   Content="Remove"
                                                   Command="{Binding $parent[UserControl].((vm:DropTableEditorViewModel)DataContext).RemoveItemCommand}"
                                                   CommandParameter="{Binding}"
                                                   Background="#CC4444"
                                                   Foreground="White"
                                                   Padding="8,4"
                                                   Margin="2"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Add Item Row -->
                            <Border Background="#222222" 
                                   CornerRadius="4" 
                                   Padding="10"
                                   IsVisible="{Binding Items.Count, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}">
                                <TextBlock Text="No items in this drop table. Items are optional - you can use gold, XP, and training points only. Click 'Add Item' to add items."
                                          Foreground="#CCCCCC"
                                          FontStyle="Italic"
                                          HorizontalAlignment="Center"
                                          TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- No Selection -->
            <Border Grid.Column="1" 
                    Background="#333333"
                    CornerRadius="6"
                    Padding="40"
                    BorderBrush="#888888"
                    BorderThickness="1"
                    IsVisible="{Binding SelectedDropTable, Converter={x:Static ObjectConverters.IsNull}}">
                <TextBlock Text="Select a drop table to edit, or create a new one."
                          Foreground="#CCCCCC"
                          FontSize="16"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>