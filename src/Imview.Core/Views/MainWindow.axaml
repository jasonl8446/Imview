<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Imview.Core.ViewModels"
        xmlns:views="clr-namespace:Imview.Core.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Avalonia.Notification.Controls;assembly=Notification.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="Imview.Core.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Imview - Imlight Server Management Tool"
        WindowState="Maximized"
        MinWidth="1200"
        MinHeight="800"
        Background="#1E1E1E">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TabControl ItemsSource="{Binding TabManager.Tabs}" 
                    SelectedItem="{Binding TabManager.SelectedTab}"
                    Grid.Column="0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Padding="0">
            <TabControl.Styles>
                <Style Selector="TabItem">
                    <Setter Property="MinHeight" Value="28"/>
                    <Setter Property="Padding" Value="4,0"/>
                    <Setter Property="Margin" Value="2,0,2,0"/>
                </Style>
                <Style Selector="TabItem:pointerover">
                    <Setter Property="Background" Value="#34343A"/>
                </Style>
                <Style Selector="TabItem:selected">
                    <Setter Property="Background" Value="#2B2B30"/>
                </Style>
            </TabControl.Styles>
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0" ClipToBounds="False">
                        <Border Background="#2B2B30"
                                CornerRadius="3"
                                Padding="0"/>

                        <Grid Margin="8,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding Title}"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="6,2"
                                       TextTrimming="CharacterEllipsis"/>

                            <Button Grid.Column="1"
                                    Content="✕"
                                    Command="{Binding CloseCommand}"
                                    IsVisible="{Binding CanClose}"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Foreground="White"
                                    Padding="4,0"
                                    Margin="4,0,4,0"
                                    FontSize="11"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="2"
                                Background="{StaticResource ImviewAccentBrush}"
                                VerticalAlignment="Bottom"/>
                    </Grid>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:TabItemViewModel}">
                    <ContentControl Content="{Binding Content}">
                        <ContentControl.DataTemplates>
                            <DataTemplate DataType="{x:Type vm:SplashPageViewModel}">
                                <views:SplashPage />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:QuestTemplateEditorViewModel}">
                                <views:QuestTemplateEditorView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:PacketQuestViewModel}">
                                <views:PacketQuestView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:ObjectPropertyBlobViewModel}">
                                <views:ObjectPropertyBlobView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:QuestBrowserViewModel}">
                                <views:QuestBrowserView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:ZoneEditorViewModel}">
                                <views:ZoneEditorView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:DropTableEditorViewModel}">
                                <views:DropTableEditorView />
                            </DataTemplate>
                        </ContentControl.DataTemplates>
                    </ContentControl>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <controls:NotificationMessageContainer Manager="{Binding Manager}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10"/>
    </Grid>
</Window>