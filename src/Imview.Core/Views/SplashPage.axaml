<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Imview.Core.ViewModels"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="600"
             x:Class="Imview.Core.Views.SplashPage"
             x:DataType="vm:SplashPageViewModel">

    <Grid Background="#1E1E1E">
        <StackPanel VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Spacing="40">
            
            <!-- Logo and Title -->
            <StackPanel Spacing="20">
                <Border Width="160" 
                        Height="160" 
                        Background="Transparent">
                    <Image Source="avares://Imview.Core/Assets/logo.png"/>
                </Border>
                
                <StackPanel Spacing="8" 
                          HorizontalAlignment="Center">
                    <TextBlock Text="Imview"
                             FontSize="48"
                             FontWeight="Bold"
                             Foreground="White"
                             HorizontalAlignment="Center"/>
                             
                    <TextBlock Text="Imlight's data recollection tool"
                             FontSize="16"
                             Foreground="#CCCCCC"
                             HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Sections -->
            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" Rows="2" HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#333333"
                                CornerRadius="8"
                                Margin="10"
                                Padding="20"
                                Width="350"
                                MinHeight="250">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Title}"
                                             FontSize="24"
                                             FontWeight="SemiBold"
                                             Foreground="White"/>
                                    <TextBlock Text="Some options require authentication"
                                             FontSize="12"
                                             FontStyle="Italic"
                                             Foreground="#AAAAAA"
                                             IsVisible="{Binding IsQuestSection}"/>
                                </StackPanel>
                                
                                <StackPanel Spacing="8">
                                    <Button Content="{Binding FirstButtonText}"
                                            Command="{Binding FirstButtonCommand}"
                                            HorizontalAlignment="Stretch"
                                            Height="40"
                                            Classes="accent"/>
                                            
                                    <Button Content="{Binding SecondButtonText}"
                                            Command="{Binding SecondButtonCommand}"
                                            HorizontalAlignment="Stretch"
                                            Height="40"
                                            IsVisible="{Binding HasSecondButton}"/>

                                    <Button Content="{Binding ThirdButtonText}"
                                            Command="{Binding ThirdButtonCommand}"
                                            HorizontalAlignment="Stretch"
                                            Height="40"
                                            IsVisible="{Binding HasThirdButton}"/>

                                    <Button Content="{Binding FourthButtonText}"
                                            Command="{Binding FourthButtonCommand}"
                                            HorizontalAlignment="Stretch"
                                            Height="40"
                                            IsVisible="{Binding HasFourthButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>