<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Imview.Core.ViewModels"
        x:Class="Imview.Core.Views.WadSelectionDialog"
        x:DataType="vm:WadSelectionDialogViewModel"
        Title="{Binding DialogTitle}"
        Width="500"
        Height="600"
        MinWidth="400"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        CanResize="true">

    <Design.DataContext>
        <vm:WadSelectionDialogViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="15">
        
        <!-- Search Section -->
        <Border Grid.Row="0" 
                Background="#2B2B30" 
                CornerRadius="5" 
                Padding="12"
                Margin="0,0,0,15">
            <StackPanel Spacing="10">
                <TextBlock Text="Search for a WAD file to view:"
                         FontSize="14"
                         FontWeight="Medium"
                         Foreground="White"/>
                
                <TextBox Name="SearchTextBox"
                         Text="{Binding SearchText}"
                         Watermark="{Binding SearchPlaceholder}"
                         FontSize="14"
                         Height="35"
                         Background="#383838"
                         BorderBrush="#555555"
                         Foreground="White"/>
                
                <TextBlock Text="{Binding WadCountText}"
                         FontSize="11"
                         Foreground="#AAAAAA"
                         HorizontalAlignment="Right"/>
            </StackPanel>
        </Border>

        <!-- WAD List Section -->
        <Border Grid.Row="1" 
                Background="#2B2B30" 
                CornerRadius="5" 
                Padding="8">
            <Grid RowDefinitions="Auto,*">
                
                <TextBlock Grid.Row="0"
                         Text="Available WAD Files:"
                         FontSize="12"
                         FontWeight="Medium"
                         Foreground="#CCCCCC"
                         Margin="8,8,8,12"/>
                
                <ScrollViewer Grid.Row="1"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                    
                    <ListBox ItemsSource="{Binding FilteredWads}"
                           SelectedItem="{Binding SelectedWad}"
                           Background="Transparent"
                           BorderThickness="0"
                           SelectionMode="Single">
                        
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent"
                                      Padding="12,8"
                                      Margin="2">
                                    <Border.Styles>
                                        <Style Selector="Border:pointerover">
                                            <Setter Property="Background" Value="#3A3A3A"/>
                                        </Style>
                                    </Border.Styles>
                                    
                                    <StackPanel>
                                        <TextBlock Text="{Binding}"
                                                 FontSize="13"
                                                 FontWeight="Medium"
                                                 Foreground="White"/>
                                        <TextBlock Text="{Binding, StringFormat='WAD: {0}'}"
                                                 FontSize="10"
                                                 Foreground="#888888"
                                                 Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="#007ACC"/>
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#1E7CE8"/>
                            </Style>
                        </ListBox.Styles>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Button Section -->
        <Grid Grid.Row="2" 
              ColumnDefinitions="*,Auto,Auto" 
              Margin="0,15,0,0">
            
            <TextBlock Grid.Column="0"
                     Text="{Binding SelectedWad}"
                     FontSize="12"
                     Foreground="#CCCCCC"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"/>
            
            <Button Grid.Column="1"
                    Content="Open"
                    Command="{Binding ConfirmSelectionCommand}"
                    IsEnabled="{Binding SelectedWad, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Classes="accent"
                    Width="80"
                    Height="32"
                    Margin="0,0,10,0"/>
            
            <Button Grid.Column="2"
                    Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Width="80"
                    Height="32"/>
        </Grid>
    </Grid>
</Window>